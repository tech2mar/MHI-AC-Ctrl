<?xml version="1.0" encoding="utf-8"?>
<!--
  This app talks to a self-hosted OpenWebUI instance on the user's home network,
  which is very commonly reachable only via plain HTTP (e.g. http://192.168.x.x:3000).
  Cleartext traffic is therefore allowed app-wide. If your OpenWebUI is served via
  HTTPS (e.g. behind a reverse proxy), that continues to work as normal.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
